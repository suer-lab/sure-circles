# secrets
.env
.env.*
!.env.example
*.pem

# circuit build artifacts (large / regenerable / trusted-setup entropy)
# NOTE: verification_key.json is exported to circuits/verification_key.json
# (outside build/) specifically so it is NOT caught by this rule and gets committed.
circuits/build/
*.ptau
*.zkey
*.wtns
# generated by circuits/scripts/gen-circuit.cjs from
# membership.template.circom + config.json (see README "Changing the Merkle
# tree depth") — the template is the committed source, this is a build output.
circuits/membership.circom
circuits/*.sha256
# app/public/circuits/ is populated by `npm run sync-circuit` (see
# app/scripts/sync-circuit.mjs) from circuits/build/ — same reasoning.
app/public/circuits/

# rust
target/
Cargo.lock.bak

# node
node_modules/
dist/
.vite/
*.log
npm-debug.log*

# misc
.DS_Store
scratch/

# coverage reports (generated by `just coverage` / CI)
coverage/
contracts/coverage/
**/coverage/

# stryker mutation testing (on-demand, not CI)
.stryker-tmp/
packages/client/reports/

# local tooling config (not project source)
.claude/
.agents/
issue.md
TODO.md
skills-lock.json

# Soroban test snapshots written on every `cargo test` run (the xdr_goldens/ directory IS committed)
contracts/circles/test_snapshots/test/

# Binary build outputs that must never be committed (see docs/artifact-policy.md). They are published, if at all,
# as clearly labelled DEVELOPMENT-ONLY release assets together with their recorded hashes.
*.wasm
*.r1cs
*.sym

# Local tooling and migration material live outside the repository. These rules are defense in depth only.
/_tools/
/_reference/

# editor, OS and backup files
.vscode/
.idea/
*.swp
*.swo
*~
*.bak
*.orig
*.rej
*.tmp
Thumbs.db
*.p12
*.pfx
