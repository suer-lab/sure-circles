# Sure Circles - scripts/ configuration (testnet only).
# Copy to `.env` (git-ignored) and fill in. NEVER commit a real `.env`.
# NEVER put a mainnet secret key here. Use a throwaway, friendbot-funded testnet account.

# Stellar network (public testnet endpoints; no credentials involved)
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Throwaway testnet admin identity (secret key starts with S). Leave empty until needed.
ADMIN_SECRET_KEY=

# Filled in after you deploy your own contract (56 characters, starts with C).
SURE_CIRCLES_CONTRACT_ID=

# Token contract used for the pot (native XLM wrapper on testnet by default).
TEST_TOKEN_CONTRACT_ID=
