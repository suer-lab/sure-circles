    "compile": "node scripts/compile.mjs",
    "setup:dev": "node scripts/setup-dev.mjs",
    "verify-setup": "node scripts/verify-setup.mjs",
    "test": "mocha --require tsx/cjs 'test/**/*.test.js' --timeout 120000",
