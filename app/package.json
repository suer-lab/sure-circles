{
  "name": "@sure-circles/app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Browser app for Sure Circles.",
  "license": "MIT",
  "engines": {
    "node": "^22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:full": "npm run sync-circuit && vite",
    "sync-circuit": "node scripts/sync-circuit.mjs",
    "build": "npm run sync-circuit && vite build",
    "build:analyze": "npm run sync-circuit && ANALYZE=1 vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "dependencies": {
    "@stellar/freighter-api": "6.0.1",
    "@stellar/stellar-sdk": "17.2.0",
    "@sure-circles/client": "0.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "4.1.12",
    "jsdom": "26.1.0",
    "rollup-plugin-visualizer": "5.14.0",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "vitest-axe": "0.1.0"
  }
}
