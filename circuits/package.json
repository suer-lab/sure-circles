{
  "name": "@sure-circles/circuits",
  "version": "0.0.0",
  "private": true,
  "description": "Zero-knowledge membership circuit and its checks for Sure Circles.",
  "license": "MIT",
  "engines": {
    "node": "^22.13.0"
  },
  "keywords": [
    "stellar",
    "soroban",
    "zk",
    "groth16",
    "circom",
    "circuits"
  ],
  "scripts": {
