{
  "name": "@sure-circles/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Pure cryptographic primitives for Sure Circles: Poseidon hashing, Merkle trees, and identity/nullifier derivation.",
  "license": "MIT",
  "engines": {
    "node": "^22.13.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "keywords": [
    "zk",
    "poseidon",
    "merkle",
    "bls12381",
    "crypto",
    "primitives"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "17.2.0",
    "poseidon-bls12381": "1.0.2"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "fast-check": "4.10.2",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
