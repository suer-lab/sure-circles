# Sure Circles - app configuration (testnet only). Copy to `.env.local` (git-ignored).
# Every VITE_* value is bundled into the browser build and is PUBLIC.
# Never put a secret key, token, or private URL in a VITE_* variable.

VITE_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
VITE_STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Contract IDs of your own deployment (56 characters, start with C).
VITE_SURE_CIRCLES_CONTRACT_ID=
VITE_TEST_TOKEN_CONTRACT_ID=
