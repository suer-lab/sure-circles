{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "esModuleInterop": true,
    "noEmit": true,
    // Type-check against client source: the package entry points at dist/, which is not built here.
    "paths": {
      "@sure-circles/client": ["../packages/client/src/index.ts"],
      "@sure-circles/client/internal": ["../packages/client/src/internal.ts"],
      "@sure-circles/client/prove": ["../packages/client/src/prove.ts"]
    },
    "types": ["node"]
  },
  "include": ["*.ts"]
}
