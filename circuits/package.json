  "dependencies": {
    "poseidon-bls12381": "1.0.2",
    "poseidon-bls12381-circom": "1.0.0"
  },
  "devDependencies": {
    "chai": "6.2.2",
    "circom_tester": "0.0.24",
    "mocha": "12.0.2",
    "snarkjs": "0.7.6",
    "tsx": "4.23.15"
  }
